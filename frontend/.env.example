# Copy to .env and adjust. Vite only exposes vars prefixed with VITE_.
#
# Leave VITE_API_BASE_URL unset to let config.js infer it from whatever
# host loaded the page — works for both localhost and phone-over-LAN
# access without editing anything. Only set it to override that, e.g.
# pointing at a staging backend.
# VITE_API_BASE_URL=http://localhost:8000

# If your backend isn't on the default :8000 (e.g. it's on :8001 because
# 8000 was already taken), set that here instead — keeps the host
# auto-detection above working for phone access too.
# VITE_API_PORT=8001

VITE_STORE_ID=store_001
